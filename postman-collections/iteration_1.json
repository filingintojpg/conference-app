      "name": "applications",
      "item": [
        {
          "name": "createApplication",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Participant-Id",
                "value": "{{participantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"directionId\": {{directionId}},\n  \"title\": \"Spring Boot\",\n  \"abstractText\": \"Application abstract\",\n  \"content\": \"Application content\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response is JSON', function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Response contains application id', function () {",
                  "    pm.expect(body.id).to.exist;",
                  "    pm.expect(body.id).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('Application is created with SUBMITTED status', function () {",
                  "    pm.expect(body.status).to.eql('SUBMITTED');",
                  "});",
                  "",
                  "pm.test('Participant and direction are correct', function () {",
                  "    pm.expect(body.participantId).to.eql(Number(pm.variables.get('participantId')));",
                  "    pm.expect(body.directionId).to.eql(Number(pm.variables.get('directionId')));",
                  "});",
                  "",
                  "pm.test('Created application contains expected data', function () {",
                  "    pm.expect(body.title).to.eql('Spring Boot');",
                  "    pm.expect(body.abstractText).to.eql('Application abstract');",
                  "    pm.expect(body.content).to.eql('Application content');",
                  "});",
                  "",
                  "pm.test('Timestamps are present', function () {",
                  "    pm.expect(body.createdAt).to.exist;",
                  "    pm.expect(body.updatedAt).to.exist;",
                  "    pm.expect(body.withdrawnAt).to.not.exist;",
                  "});",
                  "",
                  "pm.variables.set('applicationId', body.id);"
                ]
              }
            }
          ]
        },
