{
  "info": {
    "name": "iteration_1",
    "description": "Run the whole collection in the given order (Collection Runner) on a FRESH database: docker compose down -v, then docker compose up --build. Application ids in URLs are hard-coded: the 'normal' folder creates applications 1 and 2 and withdraws application 1, the 'errors' folder relies on that. Expected status is in square brackets in each name.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "normal",
      "item": [
        {
          "name": "[201] create: participant 1, direction 1 (id 1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Participant-Id",
                "value": "1"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/applications",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "applications"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"directionId\": 1,\n  \"title\": \"First application\",\n  \"abstractText\": \"Application abstract\",\n  \"content\": \"Application content\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
